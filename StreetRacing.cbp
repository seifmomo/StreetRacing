<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Fast &amp; Furious: 3D Street Racing" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="bin/Release/StreetRacing" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add library="freeglut" />
					<Add library="opengl32" />
					<Add library="glu32" />
				</Linker>
			</Target>
			<Target title="Debug">
				<Option output="bin/Debug/StreetRacing" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="freeglut" />
					<Add library="opengl32" />
					<Add library="glu32" />
				</Linker>
				<Option run_command="bin/Debug/StreetRacing" />
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Linker>
			<Add option="-static" />
		</Linker>
		<Unit title="main.cpp">
			<Filename name="main.cpp" />
		</Unit>
		<Extensions>
			<code_completion />
			<debugger />
			<diagnostics />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
